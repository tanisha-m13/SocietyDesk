# SocietyDesk Database Configuration
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/societydesk_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.username=root
# Update db.password with your MySQL root password:
db.password=YOUR_MYSQL_PASSWORD

# HikariCP Pool Settings
hikari.maximumPoolSize=10
hikari.minimumIdle=2
hikari.idleTimeout=30000
hikari.connectionTimeout=20000
hikari.maxLifetime=1800000
